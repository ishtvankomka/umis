    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@umis/core": "workspace:*",
    "@umis/wallet": "workspace:*"
  },
  "peerDependencies": {
    "@animo-id/expo-secure-environment": "^0.3.0",
    "expo": ">=58.0.0",
    "expo-crypto": ">=58.0.7",
