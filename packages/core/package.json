{
  "name": "@umis/core",
  "version": "0.0.0",
  "description": "UMIS profile, types, crypto providers, JWS, SD-JWT VC codec, frames and events.",
  "keywords": [
    "umis",
    "verifiable-credentials",
    "sd-jwt-vc",
    "offline-verification",
    "typescript",
    "core"
  ],
  "homepage": "https://github.com/ishtvankomka/umis/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ishtvankomka/umis/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishtvankomka/umis.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./noble": {
      "types": "./dist/noble.d.ts",
      "default": "./dist/noble.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:",
    "@sd-jwt/core": "catalog:",
    "canonicalize": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "jose": "catalog:"
  }
}
