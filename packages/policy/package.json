{
  "name": "@umis/policy",
  "version": "0.0.0",
  "description": "Checkpoint policy, risk-class caps, JSON Schema and decision ledger.",
  "keywords": [
    "umis",
    "verifiable-credentials",
    "sd-jwt-vc",
    "offline-verification",
    "typescript",
    "policy"
  ],
  "homepage": "https://github.com/ishtvankomka/umis/tree/main/packages/policy#readme",
  "bugs": {
    "url": "https://github.com/ishtvankomka/umis/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishtvankomka/umis.git",
    "directory": "packages/policy"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
